# =====================================================================
# OmniTwin Cognitive Engine — Environment Configuration Template
# =====================================================================

# LLM Provider Selection
# Options:
#   - auto         : Priority chain (pi-gateway -> openrouter -> vertex-gemini -> simulator)
#   - pi-gateway   : Local / Private Gateway (http://127.0.0.1:4000/v1)
#   - openrouter   : OpenRouter Cloud API (https://openrouter.ai/api/v1)
#   - vertex       : Google Cloud Vertex AI / Gemini REST API
#   - simulator    : Deterministic offline grounded safety simulator (no keys needed)
LLM_PROVIDER=auto

# 1. PI Gateway / Local LLM
PI_GATEWAY_URL=http://127.0.0.1:4000/v1
PI_GATEWAY_MODEL=deepseek/deepseek-v4-flash
PI_GATEWAY_API_KEY=

# 2. OpenRouter Cloud
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# 3. Google Vertex AI / Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Networking & Service Ports (Default binds to loopback for security)
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_ADDR=localhost:50051
GATEWAY_PORT=3030

# Security & Multi-Tenancy (Optional API Key Protection)
OMNITWIN_API_KEY=
DEFAULT_TENANT_ID=default
